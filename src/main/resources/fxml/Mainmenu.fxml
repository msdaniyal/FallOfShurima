<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="rootPane"
            prefHeight="600.0"
            prefWidth="900.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="seng201.team0.controller.MainMenuController"
            stylesheets="@../css/mainmenu.css"
            style="-fx-background-color: black;">

    <Pane fx:id="contentPane"
          prefWidth="900"
          prefHeight="600">

        <ImageView fx:id="backgroundImage"
                   preserveRatio="false"
                   mouseTransparent="true">
            <image>
                <Image url="@../images/mainmenu.png" />
            </image>
        </ImageView>

        <!-- Top info bar -->
        <Pane layoutX="35"
              layoutY="20"
              prefWidth="830"
              prefHeight="45"
              style="-fx-background-color: rgba(0,0,0,0.55);
             -fx-border-color: gold;
             -fx-border-width: 2;">

            <!-- Left: party members -->
            <HBox layoutX="25"
                  layoutY="5"
                  spacing="8"
                  alignment="CENTER_LEFT">

                <ImageView fitWidth="33"
                           fitHeight="32"
                           preserveRatio="true"
                           mouseTransparent="true">
                    <image>
                        <Image url="@../images/sword.png" />
                    </image>
                </ImageView>

                <Label fx:id="partyCountLabel"
                       text="0 / 5"
                       textFill="WHITE"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;" />

            </HBox>

            <!-- Center: guild name -->
            <Label fx:id="guildNameLabel"
                   layoutX="265"
                   layoutY="9"
                   prefWidth="300"
                   alignment="CENTER"
                   text="Guild Name"
                   textFill="GOLD"
                   style="-fx-font-size: 23px; -fx-font-weight: bold;" />

            <!-- Right: gold -->
            <HBox layoutX="675"
                  layoutY="5"
                  spacing="8"
                  alignment="CENTER_RIGHT"
                  prefWidth="130">

                <ImageView fitWidth="40"
                           fitHeight="32"
                           preserveRatio="true"
                           mouseTransparent="true">
                    <image>
                        <Image url="@../images/gold.png" />
                    </image>
                </ImageView>

                <Label fx:id="goldLabel"
                       text="0"
                       textFill="WHITE"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;" />

            </HBox>

        </Pane>

        <!-- Title -->
        <Label text="Main Menu"
               layoutX="370"
               layoutY="130"
               textFill="GOLD"
               style="-fx-font-size: 38px; -fx-font-weight: bold;" />

        <!-- Buttons -->
        <VBox layoutX="350"
              layoutY="270"
              spacing="18"
              alignment="CENTER">

            <Button text="START QUEST"
                    onAction="#onStartQuest"
                    prefWidth="250"
                    prefHeight="50"
                    styleClass="main-menu-button" />

            <Button text="MY PARTY"
                    onAction="#onMyParty"
                    prefWidth="250"
                    prefHeight="50"
                    styleClass="main-menu-button" />

            <Button text="SHOP"
                    onAction="#onShop"
                    prefWidth="250"
                    prefHeight="50"
                    styleClass="main-menu-button" />

        </VBox>

        <Label fx:id="messageLabel"
               layoutX="250"
               layoutY="520"
               prefWidth="400"
               textAlignment="CENTER"
               textFill="LIGHTGREEN"
               style="-fx-font-size: 15px;" />

        <HBox fx:id="potionInventoryBar"
              layoutX="365"
              layoutY="505"
              spacing="28"
              alignment="CENTER"
              prefWidth="220"
              prefHeight="70"
              style="-fx-background-color: rgba(0,0,0,0.45);
             -fx-border-color: #d6b63f;
             -fx-border-width: 2;
             -fx-border-radius: 14;
             -fx-background-radius: 14;
             -fx-padding: 8;">

            <VBox alignment="CENTER" spacing="3">
                <ImageView fx:id="smallPotionInventoryImage"
                           fitWidth="34"
                           fitHeight="34"
                           preserveRatio="true" />
                <Label fx:id="smallPotionInventoryLabel"
                       text="x0"
                       textFill="WHITE"
                       style="-fx-font-size: 16px;
                      -fx-font-weight: bold;
                      -fx-effect: dropshadow(gaussian, black, 5, 0.8, 0, 0);" />
            </VBox>

            <VBox alignment="CENTER" spacing="3">
                <ImageView fx:id="partyPotionInventoryImage"
                           fitWidth="34"
                           fitHeight="34"
                           preserveRatio="true" />
                <Label fx:id="partyPotionInventoryLabel"
                       text="x0"
                       textFill="WHITE"
                       style="-fx-font-size: 16px;
                      -fx-font-weight: bold;
                      -fx-effect: dropshadow(gaussian, black, 5, 0.8, 0, 0);" />
            </VBox>

            <VBox alignment="CENTER" spacing="3">
                <ImageView fx:id="fullRestoreInventoryImage"
                           fitWidth="34"
                           fitHeight="34"
                           preserveRatio="true" />
                <Label fx:id="fullRestoreInventoryLabel"
                       text="x0"
                       textFill="WHITE"
                       style="-fx-font-size: 16px;
                      -fx-font-weight: bold;
                      -fx-effect: dropshadow(gaussian, black, 5, 0.8, 0, 0);" />
            </VBox>

        </HBox>

    </Pane>

</AnchorPane>