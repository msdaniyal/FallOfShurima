<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seng201.team0.controller.MemoryGameController">

    <children>

        <!-- Sky gradient (top 600px) -->
        <Rectangle fx:id="skyRect" arcHeight="0" arcWidth="0" height="600.0" layoutX="1.0" width="900.0">
            <fill>
                <LinearGradient endX="0" endY="1" proportional="true" startX="0" startY="0">
                    <stops>
                        <Stop color="#1a6dd4" offset="0.0" />
                        <Stop color="#a8d8f0" offset="1.0" />
                    </stops>
                </LinearGradient>
            </fill>
        </Rectangle>


        <!-- Status label -->
        <Label fx:id="statusLabel" alignment="CENTER" layoutX="208.0" layoutY="91.0" prefHeight="40.0" prefWidth="485.0" text="Remember the sequence to attack!" textFill="white" wrapText="true">
            <font>
                <Font name="JetBrains Mono ExtraLight" size="23.0" />
            </font>
        </Label>

        <!-- Timer label -->
        <Label fx:id="timerLabel" layoutX="233.0" layoutY="131.0" prefWidth="200.0" text="" textFill="white">
            <font>
                <Font name="JetBrains Mono ExtraLight" size="20.0" />
            </font>
        </Label>

        <!-- Start button — invalid after first click in controller -->
        <Button fx:id="startButton" layoutX="236.0" layoutY="161.0" mnemonicParsing="false" onAction="#startMemoryAttack" prefHeight="40.0" prefWidth="194.0" text="Ready to Remember!" textAlignment="CENTER">
            <font>
                <Font name="JetBrains Mono ExtraLight" size="16.0" />
            </font>
        </Button>

        <Button fx:id="endButton" layoutX="470.0" layoutY="161.0" mnemonicParsing="false" onAction="#endGame" prefHeight="40.0" prefWidth="194.0" text="Defend instead" textAlignment="CENTER">
            <font>
                <Font name="JetBrains Mono ExtraLight" size="16.0" />
            </font>
        </Button>

        <!-- Image grid — populated dynamically by controller -->
        <GridPane fx:id="imageContainer" hgap="30.0" layoutX="236.0" layoutY="246.0" prefHeight="0.0" prefWidth="0.0" vgap="15.0" />

    </children>
</AnchorPane>
