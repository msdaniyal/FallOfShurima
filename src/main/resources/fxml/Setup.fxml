<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane fx:id="rootPane"
            prefHeight="600.0"
            prefWidth="900.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="seng201.team0.controller.SetupController"
            style="-fx-background-color: #111111;">

    <!-- All UI content goes inside this pane -->
    <Pane fx:id="contentPane"
          prefHeight="600.0"
          prefWidth="900.0">

        <!-- Background -->
        <ImageView fx:id="backgroundImage"
                   preserveRatio="false"
                   mouseTransparent="true">
            <image>
                <Image url="@../images/setup_bg.png" />
            </image>
        </ImageView>

        <!-- Guild name row -->
        <Label layoutX="240.0"
               layoutY="80.0"
               style="-fx-font-family: Georgia;
                      -fx-font-size: 22px;
                      -fx-font-weight: bold;"
               text="GUILD NAME:"
               textFill="#C9A84C" />

        <TextField fx:id="guildNameField"
                   layoutX="440.0"
                   layoutY="75.0"
                   prefHeight="36.0"
                   prefWidth="220.0"
                   promptText="2–12 characters"
                   style="-fx-background-color: #C9A84C33;
                          -fx-border-color: #C9A84C;
                          -fx-border-width: 1.5;
                          -fx-text-fill: white;
                          -fx-font-family: Georgia;
                          -fx-font-size: 14px;
                          -fx-prompt-text-fill: #aaaaaa;" />

        <!-- Heading -->
        <Label layoutX="40.0"
               layoutY="170.0"
               style="-fx-font-family: Georgia;
                      -fx-font-size: 26px;
                      -fx-font-weight: bold;"
               text="WHICH GOD WARRIOR ARE YOU?"
               textFill="#C9A84C" />

        <!-- Aatrox image -->
        <ImageView fx:id="aatroxImage"
                   fitHeight="280.0"
                   fitWidth="220.0"
                   layoutX="97.0"
                   layoutY="248.0"
                   onMouseClicked="#onAatroxSelected"
                   onMouseEntered="#onAatroxHover"
                   onMouseExited="#onHoverExit"
                   pickOnBounds="true"
                   preserveRatio="true" />

        <Label layoutX="174.0"
               layoutY="550.0"
               style="-fx-font-family: Georgia;
                      -fx-font-size: 18px;
                      -fx-font-weight: bold;"
               text="AATROX"
               textFill="#C9A84C" />

        <!-- Aatrox stat tooltip -->
        <VBox fx:id="aatroxStats"
              layoutX="60.0"
              layoutY="160.0"
              mouseTransparent="true"
              prefHeight="200.0"
              prefWidth="210.0"
              style="-fx-background-color: #000000cc;
                     -fx-border-color: #C9A84C;
                     -fx-border-width: 1.5;
                     -fx-padding: 12;"
              visible="false">

            <Label style="-fx-font-family: Georgia;
                          -fx-font-size: 15px;
                          -fx-font-weight: bold;"
                   text="⚔ AATROX"
                   textFill="#C9A84C" />

            <Label fx:id="aatroxStatText"
                   style="-fx-font-family: Georgia;
                          -fx-font-size: 12px;"
                   textFill="white"
                   wrapText="true" />

        </VBox>

        <!-- Xolaani image -->
        <ImageView fx:id="xolaaniImage"
                   fitHeight="280.0"
                   fitWidth="220.0"
                   layoutX="554.0"
                   layoutY="248.0"
                   onMouseClicked="#onXolaaniSelected"
                   onMouseEntered="#onXolaaniHover"
                   onMouseExited="#onHoverExit"
                   pickOnBounds="true"
                   preserveRatio="true" />

        <Label layoutX="632.0"
               layoutY="550.0"
               style="-fx-font-family: Georgia;
                      -fx-font-size: 18px;
                      -fx-font-weight: bold;"
               text="XOLAANI"
               textFill="#C9A84C" />

        <!-- Xolaani stat tooltip -->
        <VBox fx:id="xolaaniStats"
              layoutX="620.0"
              layoutY="160.0"
              mouseTransparent="true"
              prefHeight="200.0"
              prefWidth="210.0"
              style="-fx-background-color: #000000cc;
                     -fx-border-color: #C9A84C;
                     -fx-border-width: 1.5;
                     -fx-padding: 12;"
              visible="false">

            <Label style="-fx-font-family: Georgia;
                          -fx-font-size: 15px;
                          -fx-font-weight: bold;"
                   text="⚔ XOLAANI"
                   textFill="#C9A84C" />

            <Label fx:id="xolaaniStatText"
                   style="-fx-font-family: Georgia;
                          -fx-font-size: 12px;"
                   textFill="white"
                   wrapText="true" />

        </VBox>

        <!-- Validation label -->
        <Label fx:id="validationLabel"
               alignment="CENTER"
               layoutX="300.0"
               layoutY="510.0"
               prefWidth="300.0"
               style="-fx-font-family: Georgia;
                      -fx-font-size: 14px;"
               text=""
               textFill="red" />

        <!-- Confirm button -->
        <Button layoutX="375.0"
                layoutY="550.0"
                onAction="#onConfirm"
                prefHeight="38.0"
                prefWidth="150.0"
                style="-fx-background-color: #C9A84C;
                       -fx-text-fill: #1a0a00;
                       -fx-font-family: Georgia;
                       -fx-font-size: 15px;
                       -fx-font-weight: bold;
                       -fx-cursor: hand;"
                text="CONFIRM" />

        <!-- ═══════════════════ DIFFICULTY POPUP OVERLAY ═══════════════════ -->
        <Rectangle fx:id="popupOverlay"
                   height="600.0"
                   width="900.0"
                   layoutX="0.0"
                   layoutY="0.0"
                   fill="#000000AA"
                   visible="false" />

        <VBox fx:id="difficultyPopup"
              layoutX="245.0"
              layoutY="110.0"
              prefWidth="410.0"
              spacing="14.0"
              visible="false"
              style="-fx-background-color: linear-gradient(to bottom, #1b1623, #0f0b14);
             -fx-border-color: #d4af37;
             -fx-border-width: 2.5;
             -fx-border-radius: 14;
             -fx-background-radius: 14;
             -fx-padding: 18 20 18 20;">

            <children>

                <!-- Title -->
                <VBox alignment="CENTER" spacing="4.0">
                    <children>
                        <Label text="⚔ Select Difficulty"
                               textFill="#f4d36b"
                               style="-fx-font-family: Georgia;
                              -fx-font-size: 24px;
                              -fx-font-weight: bold;" />
                    </children>
                </VBox>

                <!-- Divider -->
                <Rectangle height="1.5"
                           width="360.0"
                           fill="#d4af37" />

                <!-- Easy -->
                <Button fx:id="easyBtn"
                        maxWidth="Infinity"
                        prefHeight="62.0"
                        onAction="#onEasySelected"
                        text="Easy"
                        wrapText="true"
                        style="-fx-background-color: linear-gradient(to bottom, #6f8f3f, #4f682a);
                       -fx-text-fill: white;
                       -fx-font-family: Georgia;
                       -fx-font-size: 28px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 10;
                       -fx-border-radius: 10;
                       -fx-border-color: #b7d37a;
                       -fx-border-width: 1.5;
                       -fx-cursor: hand;" />

                <!-- Normal -->
                <Button fx:id="normalBtn"
                        maxWidth="Infinity"
                        prefHeight="62.0"
                        onAction="#onNormalSelected"
                        text="Normal"
                        wrapText="true"
                        style="-fx-background-color: linear-gradient(to bottom, #4e5f87, #33405f);
                       -fx-text-fill: white;
                       -fx-font-family: Georgia;
                       -fx-font-size: 28px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 10;
                       -fx-border-radius: 10;
                       -fx-border-color: #8fa8da;
                       -fx-border-width: 1.5;
                       -fx-cursor: hand;" />

                <!-- Hard -->
                <Button fx:id="hardBtn"
                        maxWidth="Infinity"
                        prefHeight="62.0"
                        onAction="#onHardSelected"
                        text="Hard"
                        wrapText="true"
                        style="-fx-background-color: linear-gradient(to bottom, #8b3f3f, #5f2525);
                       -fx-text-fill: white;
                       -fx-font-family: Georgia;
                       -fx-font-size: 28px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 10;
                       -fx-border-radius: 10;
                       -fx-border-color: #d88a8a;
                       -fx-border-width: 1.5;
                       -fx-cursor: hand;" />

            </children>
        </VBox>

    </Pane>

</AnchorPane>