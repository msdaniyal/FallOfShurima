<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seng201.team0.controller.SetupController">

    <children>

        <!-- Background image -->
        <ImageView fitHeight="600.0" fitWidth="900.0" layoutX="0.0" layoutY="0.0" pickOnBounds="true" preserveRatio="false">
            <image><Image url="@../images/setup_bg.png" /></image>
        </ImageView>

        <!-- Dark overlay for readability -->
        <Rectangle height="600.0" layoutX="0.0" layoutY="0.0" width="900.0">
            <fill>
                <javafx.scene.paint.Color fx:value="#00000066" />
            </fill>
        </Rectangle>

        <!-- Guild Name row -->
        <Label layoutX="40.0" layoutY="40.0" style="-fx-font-family: 'Georgia'; -fx-font-size: 22px; -fx-font-weight: bold;" text="GUILD NAME:" textFill="#C9A84C" />

        <TextField fx:id="guildNameField" layoutX="240.0" layoutY="35.0" prefHeight="36.0" prefWidth="220.0" promptText="9–12 characters" style="-fx-background-color: #C9A84C33;                           -fx-border-color: #C9A84C;                           -fx-border-width: 1.5;                           -fx-text-fill: white;                           -fx-font-family: Georgia;                           -fx-font-size: 14px;                           -fx-prompt-text-fill: #aaaaaa;" />

        <!-- "Which God Warrior are you?" heading -->
        <Label layoutX="40.0" layoutY="110.0" style="-fx-font-family: 'Georgia'; -fx-font-size: 26px; -fx-font-weight: bold;" text="WHICH GOD WARRIOR ARE YOU?" textFill="#C9A84C" />

        <!-- Aatrox image — clicking selects Faction.AATROX -->
        <ImageView fx:id="aatroxImage" fitHeight="280.0" fitWidth="220.0" layoutX="130.0" layoutY="230.0" onMouseClicked="#onAatroxSelected" pickOnBounds="true" preserveRatio="true">
            <image><Image url="@../images/Aatrox.png" /></image>
        </ImageView>

        <!-- Xolaani image — clicking selects Faction.XOLAANI -->
        <ImageView fitHeight="280.0" fitWidth="220.0" layoutX="530.0" layoutY="230.0" onMouseClicked="#onXolaaniSelected" pickOnBounds="true" preserveRatio="true" fx:id="xolaaniImage">
            <image><Image url="@../images/Xolaani.png" /></image>
        </ImageView>

        <!-- Faction name labels under each warrior -->
        <Label layoutX="210.0" layoutY="480.0" style="-fx-font-family: Georgia; -fx-font-size: 18px; -fx-font-weight: bold;" text="AATROX" textFill="#C9A84C" />

        <Label layoutX="610.0" layoutY="480.0" style="-fx-font-family: Georgia; -fx-font-size: 18px; -fx-font-weight: bold;" text="XOLAANI" textFill="#C9A84C" />

        <!-- Validation message -->
        <Label fx:id="validationLabel" alignment="CENTER" layoutX="310.0" layoutY="510.0" prefWidth="300.0" style="-fx-font-family: Georgia; -fx-font-size: 14px;" text="" textFill="red" />

        <!-- Confirm button -->
        <Button layoutX="375.0" layoutY="550.0" onAction="#onConfirm" prefHeight="38.0" prefWidth="150.0" style="-fx-background-color: #C9A84C;                        -fx-text-fill: #1a0a00;                        -fx-font-family: Georgia;                        -fx-font-size: 15px;                        -fx-font-weight: bold;                        -fx-cursor: hand;" text="READY">
         <font>
            <Font name="JetBrains Mono ExtraLight" size="12.0" />
         </font></Button>

    </children>
</AnchorPane>
