<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<AnchorPane fx:id="rootPane" prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #111111;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seng201.team76.controller.SetupController">

    <!-- All UI content goes inside this pane -->
    <Pane fx:id="contentPane" prefHeight="600.0" prefWidth="900.0">

        <!-- Background -->
        <ImageView fx:id="backgroundImage" mouseTransparent="true" preserveRatio="false">
            <image>
                <Image url="@../images/setup_bg.png" />
            </image>
        </ImageView>

        <!-- Guild name row -->
        <Label layoutX="40.0" layoutY="81.0" style="-fx-font-family: Georgia;                       -fx-font-size: 22px;                       -fx-font-weight: bold;" text="GUILD NAME:" textFill="#C9A84C" />

        <TextField fx:id="guildNameField" layoutX="230.0" layoutY="76.0" prefHeight="36.0" prefWidth="220.0" promptText="2–12 characters" style="-fx-background-color: #C9A84C33;                           -fx-border-color: #C9A84C;                           -fx-border-width: 1.5;                           -fx-text-fill: white;                           -fx-font-family: Georgia;                           -fx-font-size: 14px;                           -fx-prompt-text-fill: #aaaaaa;" />

        <!-- Heading -->
        <Label layoutX="43.0" layoutY="160.0" style="-fx-font-family: Georgia;                       -fx-font-size: 26px;                       -fx-font-weight: bold;" text="PICK YOUR CHAMPION" textFill="#C9A84C" />

        <!-- Aatrox image -->
        <ImageView fx:id="aatroxImage" fitHeight="361.0" fitWidth="248.0" layoutX="153.0" layoutY="225.0" onMouseClicked="#onAatroxSelected" onMouseEntered="#onAatroxHover" onMouseExited="#onHoverExit" pickOnBounds="true" preserveRatio="true" />

        <!-- Aatrox stat tooltip -->
        <VBox fx:id="aatroxStats" layoutX="60.0" layoutY="160.0" mouseTransparent="true" prefHeight="200.0" prefWidth="210.0" style="-fx-background-color: #000000cc;                      -fx-border-color: #C9A84C;                      -fx-border-width: 1.5;                      -fx-padding: 12;" visible="false">

            <Label style="-fx-font-family: Georgia;                           -fx-font-size: 15px;                           -fx-font-weight: bold;" text="⚔ AATROX" textFill="#C9A84C" />

            <Label fx:id="aatroxStatText" style="-fx-font-family: Georgia;                           -fx-font-size: 12px;" textFill="white" wrapText="true" />

        </VBox>

        <!-- Xolaani image -->
        <ImageView fitHeight="280.0" fitWidth="220.0" layoutX="474.0" layoutY="269.0" onMouseClicked="#onXolaaniSelected" onMouseEntered="#onXolaaniHover" onMouseExited="#onHoverExit" pickOnBounds="true" preserveRatio="true" fx:id="xolaaniImage" />

        <!-- Xolaani stat tooltip -->
        <VBox layoutX="620.0" layoutY="160.0" mouseTransparent="true" prefHeight="200.0" prefWidth="210.0" style="-fx-background-color: #000000cc;                      -fx-border-color: #C9A84C;                      -fx-border-width: 1.5;                      -fx-padding: 12;" visible="false" fx:id="xolaaniStats">

            <Label style="-fx-font-family: Georgia;                           -fx-font-size: 15px;                           -fx-font-weight: bold;" text="⚔ XOLAANI" textFill="#C9A84C" />

            <Label style="-fx-font-family: Georgia;                           -fx-font-size: 12px;" textFill="white" wrapText="true" fx:id="xolaaniStatText" />

        </VBox>

        <!-- Validation label -->
        <Label fx:id="validationLabel" alignment="CENTER" layoutX="300.0" layoutY="510.0" prefWidth="300.0" style="-fx-font-family: Georgia;                       -fx-font-size: 14px;" text="" textFill="red" />

        <!-- Confirm button -->
        <Button layoutX="630.0" layoutY="122.0" onAction="#onConfirm" prefHeight="38.0" prefWidth="150.0" style="-fx-background-color: #C9A84C;                        -fx-text-fill: #1a0a00;                        -fx-font-family: Georgia;                        -fx-font-size: 15px;                        -fx-font-weight: bold;                        -fx-cursor: hand;" text="CONFIRM" />

        <!-- ═══════════════════ DIFFICULTY POPUP OVERLAY ═══════════════════ -->
        <Rectangle fx:id="popupOverlay" fill="#000000AA" height="600.0" layoutX="0.0" layoutY="0.0" visible="false" width="900.0" />

        <VBox fx:id="difficultyPopup" layoutX="245.0" layoutY="110.0" prefWidth="410.0" spacing="14.0" style="-fx-background-color: linear-gradient(to bottom, #1b1623, #0f0b14);              -fx-border-color: #d4af37;              -fx-border-width: 2.5;              -fx-border-radius: 14;              -fx-background-radius: 14;              -fx-padding: 18 20 18 20;" visible="false">

            <children>

                <!-- Title -->
                <VBox alignment="CENTER" spacing="4.0">
                    <children>
                        <Label style="-fx-font-family: Georgia;                               -fx-font-size: 24px;                               -fx-font-weight: bold;" text="⚔ Select Difficulty" textFill="#f4d36b" />
                    </children>
                </VBox>

                <!-- Divider -->
                <Rectangle fill="#d4af37" height="1.5" width="360.0" />

                <!-- Easy -->
                <Button fx:id="easyBtn" maxWidth="Infinity" onAction="#onEasySelected" prefHeight="62.0" style="-fx-background-color: linear-gradient(to bottom, #6f8f3f, #4f682a);                        -fx-text-fill: white;                        -fx-font-family: Georgia;                        -fx-font-size: 28px;                        -fx-font-weight: bold;                        -fx-background-radius: 10;                        -fx-border-radius: 10;                        -fx-border-color: #b7d37a;                        -fx-border-width: 1.5;                        -fx-cursor: hand;" text="Easy" wrapText="true" />

                <!-- Normal -->
                <Button fx:id="normalBtn" maxWidth="Infinity" onAction="#onNormalSelected" prefHeight="62.0" style="-fx-background-color: linear-gradient(to bottom, #4e5f87, #33405f);                        -fx-text-fill: white;                        -fx-font-family: Georgia;                        -fx-font-size: 28px;                        -fx-font-weight: bold;                        -fx-background-radius: 10;                        -fx-border-radius: 10;                        -fx-border-color: #8fa8da;                        -fx-border-width: 1.5;                        -fx-cursor: hand;" text="Normal" wrapText="true" />

                <!-- Hard -->
                <Button fx:id="hardBtn" maxWidth="Infinity" onAction="#onHardSelected" prefHeight="62.0" style="-fx-background-color: linear-gradient(to bottom, #8b3f3f, #5f2525);                        -fx-text-fill: white;                        -fx-font-family: Georgia;                        -fx-font-size: 28px;                        -fx-font-weight: bold;                        -fx-background-radius: 10;                        -fx-border-radius: 10;                        -fx-border-color: #d88a8a;                        -fx-border-width: 1.5;                        -fx-cursor: hand;" text="Hard" wrapText="true" />

            </children>
        </VBox>

    </Pane>

</AnchorPane>
