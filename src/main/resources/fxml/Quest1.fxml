<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane fx:id="rootPane"
            prefWidth="900.0"
            prefHeight="600.0"
            styleClass="quest-root"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="seng201.team0.controller.Quest1Controller">

    <children>
        <Pane fx:id="contentPane"
              prefWidth="900.0"
              prefHeight="600.0"
              styleClass="quest-content">

            <children>
                <!-- Dark base prevents white gaps while images change -->
                <Rectangle layoutX="0"
                           layoutY="0"
                           width="900"
                           height="600"
                           fill="#080403" />

                <!-- Story background image area -->
                <ImageView fx:id="backgroundImage"
                           layoutX="0.0"
                           layoutY="0.0"
                           fitWidth="900.0"
                           fitHeight="390.0"
                           preserveRatio="false"
                           smooth="true" />

                <Rectangle layoutX="0"
                           layoutY="0"
                           width="900"
                           height="390"
                           fill="rgba(0,0,0,0.12)" />

                <Rectangle layoutX="0"
                           layoutY="390"
                           width="900"
                           height="210"
                           fill="linear-gradient(from 0% 0% to 0% 100%, #1b1208, #070403)" />

                <Rectangle layoutX="0"
                           layoutY="390"
                           width="900"
                           height="8"
                           fill="rgba(214,179,90,0.90)" />

                <Label fx:id="eventTitleLabel"
                       layoutX="40"
                       layoutY="18"
                       prefWidth="820"
                       prefHeight="38"
                       alignment="CENTER"
                       text="Event Title"
                       styleClass="event-title" />

                <!-- Pokemon-style dialogue panel -->
                <AnchorPane layoutX="20"
                            layoutY="410"
                            prefWidth="860"
                            prefHeight="170"
                            styleClass="dialogue-panel">

                    <children>
                        <Label fx:id="speakerLabel"
                               layoutX="20"
                               layoutY="10"
                               prefWidth="240"
                               prefHeight="24"
                               text="Speaker"
                               styleClass="speaker-label" />

                        <Label fx:id="dialogueLabel"
                               layoutX="20"
                               layoutY="40"
                               prefWidth="555"
                               prefHeight="72"
                               wrapText="true"
                               text="Dialogue text appears here."
                               styleClass="dialogue-label" />

                        <Label fx:id="choicePreviewLabel"
                               layoutX="20"
                               layoutY="116"
                               prefWidth="555"
                               prefHeight="40"
                               wrapText="true"
                               text="Hover over a command to read the full order."
                               styleClass="choice-preview-label" />

                        <Label fx:id="nextArrowLabel"
                               layoutX="548"
                               layoutY="130"
                               prefWidth="30"
                               prefHeight="24"
                               text="▼"
                               styleClass="next-arrow" />

                        <Button fx:id="continueButton"
                                layoutX="610"
                                layoutY="126"
                                prefWidth="220"
                                prefHeight="30"
                                text="Next"
                                onAction="#onContinue"
                                styleClass="continue-button" />

                        <Button fx:id="choiceAButton"
                                layoutX="600"
                                layoutY="22"
                                prefWidth="235"
                                prefHeight="36"
                                text="Choice A"
                                onAction="#onChoiceA"
                                styleClass="choice-button" />

                        <Button fx:id="choiceBButton"
                                layoutX="600"
                                layoutY="68"
                                prefWidth="235"
                                prefHeight="36"
                                text="Choice B"
                                onAction="#onChoiceB"
                                styleClass="choice-button" />

                        <Button fx:id="choiceCButton"
                                layoutX="600"
                                layoutY="114"
                                prefWidth="235"
                                prefHeight="36"
                                text="Choice C"
                                onAction="#onChoiceC"
                                styleClass="choice-button" />
                    </children>
                </AnchorPane>
            </children>
        </Pane>
    </children>

    <stylesheets>
        <URL value="@../css/quest1.css" />
    </stylesheets>
</AnchorPane>
