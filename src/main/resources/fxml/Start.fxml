<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="seng201.team0.controller.StartController">
    <children>

        <!-- Background -->
        <ImageView layoutX="0.0" layoutY="0.0"
                   fitWidth="900.0" fitHeight="600.0"
                   preserveRatio="false" pickOnBounds="false">
            <image><Image url="@../images/shurima_bg.png"/></image>
        </ImageView>

        <!-- Title — fades in on load -->
        <Label fx:id="titleLabel"
               text="THE FALL OF SHURIMA"
               layoutX="0.0" layoutY="180.0"
               prefWidth="900.0"
               alignment="CENTER"
               opacity="0.0"
               textFill="#C9A84C"
               style="-fx-font-family:Georgia;
                      -fx-font-size:48px;
                      -fx-font-weight:bold;"/>

        <!-- START button — fades in after title, pulses glow -->
        <Button fx:id="startButton"
                text="START"
                layoutX="375.0" layoutY="430.0"
                prefWidth="150.0" prefHeight="48.0"
                opacity="0.0"
                onAction="#onStart"
                style="-fx-background-color:transparent;
                       -fx-border-color:#C9A84C;
                       -fx-border-width:2;
                       -fx-text-fill:#C9A84C;
                       -fx-font-family:Georgia;
                       -fx-font-size:22px;
                       -fx-font-weight:bold;
                       -fx-cursor:hand;"/>

        <!-- Black overlay used for the transition wipe — starts fully transparent -->
        <Rectangle fx:id="transitionOverlay"
                   layoutX="0.0" layoutY="0.0"
                   width="900.0" height="600.0"
                   opacity="0.0"
                   mouseTransparent="true"
                   fill="black"/>

    </children>
</AnchorPane>
