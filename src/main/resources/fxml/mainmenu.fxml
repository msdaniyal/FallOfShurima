<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="seng201.team0.controller.MainMenuController"
            style="-fx-background-color: #111111;">

    <Label text="Main Menu"
           layoutX="360"
           layoutY="70"
           textFill="GOLD"
           style="-fx-font-size: 38px; -fx-font-weight: bold;" />

    <Label fx:id="guildNameLabel"
           layoutX="355"
           layoutY="150"
           text="Guild:"
           textFill="WHITE"
           style="-fx-font-size: 18px;" />

    <Label fx:id="goldLabel"
           layoutX="355"
           layoutY="185"
           text="Gold:"
           textFill="WHITE"
           style="-fx-font-size: 18px;" />

    <Label fx:id="partyCountLabel"
           layoutX="355"
           layoutY="220"
           text="Party Members:"
           textFill="WHITE"
           style="-fx-font-size: 18px;" />

    <VBox layoutX="350"
          layoutY="280"
          spacing="18"
          alignment="CENTER">

        <Button text="Start Quest"
                onAction="#onStartQuest"
                prefWidth="200"
                prefHeight="42"
                style="-fx-font-size: 16px; -fx-background-color: gold;" />

        <Button text="My Party"
                onAction="#onMyParty"
                prefWidth="200"
                prefHeight="42"
                style="-fx-font-size: 16px;" />

        <Button text="Shop"
                onAction="#onShop"
                prefWidth="200"
                prefHeight="42"
                style="-fx-font-size: 16px;" />

    </VBox>

    <Label fx:id="messageLabel"
           layoutX="320"
           layoutY="520"
           textFill="LIGHTGREEN"
           style="-fx-font-size: 15px;" />

</AnchorPane>