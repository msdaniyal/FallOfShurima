<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>

<AnchorPane fx:id="rootPane"
            prefWidth="900.0"
            prefHeight="600.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="seng201.team0.controller.MapController"
            style="-fx-background-color: black;">

    <Pane fx:id="contentPane"
          prefWidth="900.0"
          prefHeight="600.0">

        <ImageView fx:id="backgroundImage"
                   fitWidth="900"
                   fitHeight="600"
                   preserveRatio="false"
                   mouseTransparent="true">
            <image>
                <Image url="@../images/map_bg.png" />
            </image>
        </ImageView>

        <Label fx:id="titleLabel"
               layoutX="345"
               layoutY="42"
               text="Quest Map"
               textFill="GOLD"
               style="-fx-font-size: 44px;
                      -fx-font-weight: bold;
                      -fx-effect: dropshadow(gaussian, black, 8, 0.8, 0, 0);" />

        <Pane fx:id="mapPane"
              layoutX="0"
              layoutY="0"
              prefWidth="900"
              prefHeight="600"
              mouseTransparent="false" />

        <Label fx:id="messageLabel"
               layoutX="250"
               layoutY="545"
               prefWidth="400"
               alignment="CENTER"
               textFill="LIGHTPINK"
               style="-fx-font-size: 18px;
                      -fx-font-weight: bold;
                      -fx-effect: dropshadow(gaussian, black, 5, 0.8, 0, 0);" />

        <Button fx:id="backButton"
                layoutX="30"
                layoutY="520"
                prefWidth="130"
                prefHeight="42"
                text="Back"
                onAction="#onBack"
                style="-fx-background-color: rgba(80, 55, 20, 0.85);
                       -fx-background-radius: 16;
                       -fx-border-color: gold;
                       -fx-border-width: 2;
                       -fx-border-radius: 16;
                       -fx-text-fill: gold;
                       -fx-font-size: 18px;
                       -fx-font-weight: bold;" />

    </Pane>
</AnchorPane>